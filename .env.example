# Copiar a .env y rellenar. NO subir .env a ningun repositorio.

# --- Buzon de captura ---
IMAP_HOST=imap.gmail.com
IMAP_USER=capturasremaxmid@gmail.com
# Contrasena de aplicacion de Google (16 caracteres, sin espacios).
# NO es la contrasena de la cuenta: esa no funciona por IMAP.
# Generarla en myaccount.google.com/apppasswords con la verificacion
# en 2 pasos ya activada.
IMAP_PASS=

# Etiqueta de Gmail a donde van los correos que no se pudieron procesar.
CARPETA_REVISAR=REVISAR

# --- Modelo de extraccion ---
# PROVEEDOR: "openai" o "anthropic". Solo hace falta la llave del que uses.
PROVEEDOR=openai

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Opcional: si se omite, usa gpt-4o-mini (openai) o claude-haiku-4-5-20251001.
# MODELO=gpt-4o-mini

# --- GoHighLevel ---
# Token de respaldo. Si TOKEN_URL esta configurada, solo se usa cuando
# tracker_v1 no responde.
GHL_TOKEN=
GHL_LOCATION_ID=rkLMMyinmQJt6JTrZ8vE

# tracker_v1 (AutoKPI) entrega el access_token vigente y lo refresca solo.
# Dejar vacio para usar unicamente GHL_TOKEN.
TOKEN_URL=https://tracker.tudominio.com/api/ghl-token
TOKEN_SECRET=
GHL_TAG=Creado_por_leadmaster

# IDs de los campos personalizados. Solo hace falta ponerlos si se usa
# otra sub-cuenta; para RE/MAX MID ya vienen por defecto en el codigo.
# Se obtienen con: GET /locations/<locationId>/customFields?model=contact
# CF_CLAVE_INTERNA=MuUq6ZwtqXWLoJoOrkZ4
# CF_PROYECTO=hMkSTQHqez2nkPqb3saH

# Reintentos antes de mandar el correo a REVISAR
MAX_INTENTOS=3

# --- Alertas ---
# A donde avisar si los leads dejan de entrar a GHL. Se manda desde el mismo
# buzon de captura, no hacen falta credenciales nuevas.
# Vacio = sin alertas.
ALERTA_EMAIL=sergio@leadmaster.com.co

# Minimo de minutos entre alertas, para no inundar el buzon si fallan muchos
# correos seguidos.
ALERTA_MINUTOS=30
